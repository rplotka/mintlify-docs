  "keyFeatures": [
    "Student dashboard with assignment tracking and grade monitoring",
    "Instructor course management with schedule editor",
    "AI-assisted grading and rubric generation",
    "Series 7 exam preparation with question bank and study plans",
    "Discord integration for course communication and participation tracking",
    "Gamification with points, achievements, and leaderboards",
    "AI Course Builder for generating course content",
    "Flexible billing with self-service and enterprise plans",
    "Calendar subscription and iCal export",
    "Box cloud storage integration for assignment files"
  ],
  "publicApiSurface": [
    "GET /health — Service health check",
    "POST /api/auth/login — JWT authentication",
    "POST /api/auth/register — User registration",
    "GET /api/courses — List courses",
    "GET /api/courses/:id — Course details",
    "GET /api/assignments — List assignments",
    "POST /api/assignments/:id/submit — Submit assignment",
    "GET /api/grades — Student grades",
    "GET /api/schedule/semesters/:semesterCode/calendar — Academic calendar events",
    "GET /api/notifications — User notifications",
    "POST /api/enrollment-tokens/enroll — Enroll in course",
    "GET /api/hub/courses — Hub course listing",
    "GET /api/hub/grades — Aggregated grade view"
  ]
}
